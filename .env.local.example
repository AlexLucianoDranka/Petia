# ========================================================
# PETIA — VARIÁVEIS DE AMBIENTE
# Copie este arquivo para .env.local e preencha os valores reais
# ========================================================

# ── SUPABASE ────────────────────────────────────────────
# Obtidos em: https://supabase.com → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://SEU_PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_...
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# ── STRIPE ──────────────────────────────────────────────
# Obtidos em: https://dashboard.stripe.com/developers → API Keys
# Use sk_test_... para testes e sk_live_... para produção
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# ── RESEND (E-MAILS) ────────────────────────────────────
# Obtido em: https://resend.com → API Keys
RESEND_API_KEY=re_...
# Domínio de envio verificado no Resend (ex: petia.com.br)
RESEND_FROM_EMAIL=Petia <noreply@petia.com.br>

# ── APP ─────────────────────────────────────────────────
# URL pública da aplicação (sem barra final)
# Em desenvolvimento: http://localhost:3000
# Em produção: https://app.petia.com.br
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── WHATSAPP (opcional) ──────────────────────────────────
WHATSAPP_PROVIDER=mock
WHATSAPP_API_KEY=
WHATSAPP_INSTANCE_ID=
